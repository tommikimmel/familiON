# FamiliON local environment. Copy to `.env` (or run `make env`). Never commit `.env`.

# --- PostgreSQL ---
POSTGRES_DB=familion
POSTGRES_USER=familion
POSTGRES_PASSWORD=familion

# --- Core backend ---
SPRING_PROFILES_ACTIVE=dev
# Generate with: openssl rand -base64 48  (`make env` does it for you)
JWT_SECRET=
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P30D
MAIL_FROM=no-reply@familion.local
APP_PUBLIC_URL=http://localhost:8088
APP_VERSION=0.1.0

# --- Economic data sync ---
ECON_DOLARAPI_URL=https://dolarapi.com
ECON_ARGDATOS_URL=https://api.argentinadatos.com
ECON_SYNC_CRON="0 0 */6 * * *"

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@familion.local

# --- BFF ---
COOKIE_SECURE=false
BFF_RATE_LIMIT_PER_MIN=120
